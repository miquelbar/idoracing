# SimCoach Environment Configuration Example

# Ollama local instance URL
# For native host execution: http://localhost:11434
# For Docker Compose on Linux: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Selected model in Ollama (e.g. qwen3:14b, qwen3.8:27b-32k, qwen3:8b)
OLLAMA_MODEL=qwen3:14b

# Request timeout for model inference in seconds
OLLAMA_TIMEOUT=60.0

# Enable/disable AI coaching assistance (true/false)
AI_ENABLED=true

# Persistent SQLite database path
SIMCOACH_DB_PATH=data/simcoach.db
