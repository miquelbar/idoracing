# IdoRacing Analytics — Environment Configuration Example

# AI Provider: 'ollama' or 'openai' (also compatible with OpenRouter, DeepSeek, vLLM, etc.)
LLM_PROVIDER=ollama

# --- Local Ollama Setup (Default: 100% Free & Private) ---
# For native host execution: http://localhost:11434
# For Docker Compose on Linux: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_TIMEOUT=90.0

# --- Cloud LLM Setup (Optional: OpenAI, OpenRouter, etc.) ---
# To use OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
# To use OpenAI: OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Enable or disable AI track engineer analysis
AI_ENABLED=true

# Persistent SQLite database path
IDORACING_DB_PATH=data/idoracing.db
