#!/usr/bin/env bash
# pre-commit: deny commits whose author or committer identity
# does not match the identities already present in the history.
set -euo pipefail

# Identities accepted by this repository, taken from the existing commits.
allowed_names=()
allowed_emails=()
while IFS='|' read -r name email; do
	[[ " ${allowed_names[*]} " == *" $name "* ]] || allowed_names+=("$name")
	[[ " ${allowed_emails[*]} " == *" $email "* ]] || allowed_emails+=("$email")
done < <(git log --all --format='%an|%ae' 2>/dev/null)

if [ ${#allowed_names[@]} -eq 0 ]; then
	# No history yet (e.g. initial commit): nothing to enforce.
	exit 0
fi

deny() {
	echo "pre-commit: $1" >&2
	echo "pre-commit: commits must use one of the repository identities:" >&2
	for i in "${!allowed_names[@]}"; do
		echo "  ${allowed_names[$i]} <${allowed_emails[$i]}>" >&2
	done
	echo "pre-commit: fix it with: git config user.name '...' && git config user.email '...'" >&2
	exit 1
}

check() {
	local role=$1 name=$2 email=$3
	if [[ " ${allowed_names[*]} " != *" $name "* ]]; then
		deny "invalid $role name '$name'"
	fi
	if [[ " ${allowed_emails[*]} " != *" $email "* ]]; then
		deny "invalid $role email '$email'"
	fi
}

# git does not export the identity variables to pre-commit on every version,
# so fall back to the configured identity when they are unset.
author_name=${GIT_AUTHOR_NAME:-$(git config user.name)}
author_email=${GIT_AUTHOR_EMAIL:-$(git config user.email)}
committer_name=${GIT_COMMITTER_NAME:-$(git config user.name)}
committer_email=${GIT_COMMITTER_EMAIL:-$(git config user.email)}

check author "$author_name" "$author_email"
check committer "$committer_name" "$committer_email"

# --- Python Lint & Format Checks (ruff) ---
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

RUFF=""
if [ -x "$REPO_ROOT/.venv/bin/ruff" ]; then
	RUFF="$REPO_ROOT/.venv/bin/ruff"
elif command -v ruff >/dev/null 2>&1; then
	RUFF="ruff"
fi

if [ -n "$RUFF" ]; then
	echo "pre-commit: checking Python code with ruff..."
	"$RUFF" check "$REPO_ROOT" || {
		echo "pre-commit: ruff check failed! Please fix lint errors before committing." >&2
		exit 1
	}

	echo "pre-commit: checking Python formatting with ruff format..."
	"$RUFF" format --check "$REPO_ROOT" || {
		echo "pre-commit: ruff format check failed! Run 'ruff format .' to reformat." >&2
		exit 1
	}
else
	echo "pre-commit: WARNING: ruff not found, skipping Python linting." >&2
fi

# --- Frontend Typecheck, Build & Lint ---
if command -v npm >/dev/null 2>&1 && [ -d "$REPO_ROOT/frontend" ]; then
	staged_frontend=$(git diff --cached --name-only 2>/dev/null | grep "^frontend/" || true)
	if [ -n "$staged_frontend" ] || [ ! -s "$REPO_ROOT/frontend/dist/index.html" ]; then
		echo "pre-commit: verifying frontend build & lint..."
		(cd "$REPO_ROOT/frontend" && npm run build && npm run lint) || {
			echo "pre-commit: frontend build or lint failed! Fix TypeScript/lint errors before committing." >&2
			exit 1
		}
	fi
fi

# --- Automated Test Suite Execution (pytest) ---
PYTEST=""
if [ -x "$REPO_ROOT/.venv/bin/pytest" ]; then
	PYTEST="$REPO_ROOT/.venv/bin/pytest"
elif command -v pytest >/dev/null 2>&1; then
	PYTEST="pytest"
fi

if [ -n "$PYTEST" ]; then
	echo "pre-commit: running full pytest test suite..."
	PYTHONPATH="$REPO_ROOT" "$PYTEST" "$REPO_ROOT/tests" -q || {
		echo "pre-commit: pytest test suite failed! Please fix failing tests before committing." >&2
		exit 1
	}
else
	echo "pre-commit: WARNING: pytest not found, skipping Python tests." >&2
fi

# --- Go Unit Tests, Launcher Tests & Windows Build (recorder) ---
if command -v go >/dev/null 2>&1 && [ -d "$REPO_ROOT/recorder" ]; then
	echo "pre-commit: running Go unit tests in recorder/..."
	(cd "$REPO_ROOT/recorder" && go test ./...) || {
		echo "pre-commit: Go unit tests failed! Fix recorder tests before committing." >&2
		exit 1
	}

	echo "pre-commit: running Linux sim launcher tests in recorder/linux/..."
	(cd "$REPO_ROOT/recorder" && bash linux/test-acc-with-recorder.sh && bash linux/test-sim-launchers.sh) || {
		echo "pre-commit: Linux sim launcher tests failed! Fix launcher scripts/tests before committing." >&2
		exit 1
	}

	echo "pre-commit: verifying Windows cross-build (GOOS=windows GOARCH=amd64)..."
	tmp_exe="$(mktemp -u "${TMPDIR:-/tmp}/idoracing-recorder-XXXXXX.exe")"
	(cd "$REPO_ROOT/recorder" && GOOS=windows GOARCH=amd64 go build -trimpath -ldflags="-s -w -H=windowsgui" -o "$tmp_exe" .) || {
		rm -f "$tmp_exe"
		echo "pre-commit: Windows recorder build failed! Fix *_windows.go compilation errors before committing." >&2
		exit 1
	}
	rm -f "$tmp_exe"
fi

# --- CHANGELOG Check ---
# Ensure CHANGELOG.md is updated when functional code changes are committed.
staged_files=$(git diff --cached --name-only 2>/dev/null || true)
if [ -n "$staged_files" ]; then
	has_code_changes=0
	has_changelog=0

	while IFS= read -r file; do
		if [ "$file" = "CHANGELOG.md" ]; then
			has_changelog=1
		elif [[ "$file" =~ ^(api/|coach/|analysis/|frontend/src/|recorder/|importers/|storage/|domain/) ]]; then
			has_code_changes=1
		fi
	done <<< "$staged_files"

	if [ "$has_code_changes" -eq 1 ] && [ "$has_changelog" -eq 0 ]; then
		if [ "${SKIP_CHANGELOG:-0}" != "1" ]; then
			echo "pre-commit: ERROR: Staged changes include functional code, but CHANGELOG.md was not updated." >&2
			echo "pre-commit: Please document notable changes in CHANGELOG.md and stage it (git add CHANGELOG.md)." >&2
			echo "pre-commit: (To bypass for small chores/refactors: SKIP_CHANGELOG=1 git commit ...)" >&2
			exit 1
		fi
	fi
fi

exit 0
